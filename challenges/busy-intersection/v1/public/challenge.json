{
  "schema_version": "challenge/v1",
  "challenge_id": "busy-intersection/v1",
  "protocol": "gates/v1",
  "entrypoint": "index.html",
  "runtime": {
    "static": true,
    "network": false,
    "backend": false,
    "supported_viewport": {"width": 1440, "height": 900},
    "reset": "page reload"
  },
  "gates": {
    "vehicle_entrances": ["north", "east", "south", "west"],
    "vehicle_exits": ["north", "east", "south", "west"],
    "u_turns": false,
    "pedestrian_crossings": {
      "north": ["east-to-west", "west-to-east"],
      "south": ["east-to-west", "west-to-east"],
      "east": ["north-to-south", "south-to-north"],
      "west": ["north-to-south", "south-to-north"]
    },
    "diagram": "gate-map.svg"
  },
  "interface": {
    "global": "RalphGates",
    "api_version": "gates/v1",
    "register": ["carArrived", "pedestrianArrived"],
    "finish": ["carFinished", "pedestrianFinished"]
  },
  "evaluator_owned_monitoring": [
    "arrival and completion timestamps",
    "issued, completed and outstanding ledgers",
    "completion latency",
    "throughput by load stage",
    "backlog growth",
    "load-to-failure and cooldown recovery",
    "browser runtime and blocked network evidence"
  ],
  "human_review": [
    "visible agreement with finish notifications",
    "traffic-control plausibility and safety",
    "motion fidelity and queue behavior",
    "information design, visual quality and originality"
  ],
  "creative_latitude": "Choose a coherent 2D, 2.5D, or 3D visual identity and any simulation/control architecture. Keep gates, traffic state and critical distinctions legible."
}
